#            PTEP Payment Gateway — configuration template
#
# Copy to .env and fill in. This file is committed; .env is not.
#
#     cp .env.example .env
#
# Every value here is a PLACEHOLDER. Nothing in this file is a working
# credential, and nothing real should ever be committed into it.
#
# Marked [required] means the service will not start, or will refuse payments,
# without it. Everything else has a working default and can be left alone until
# you have a reason.
#
# TWO THINGS THIS FORMAT WILL NOT FORGIVE:
#
#   · Quote any value containing a space. `docker --env-file` tolerates a bare
#     space; `set -a; . .env` in a shell does not — it runs the second word as
#     a command and the service never starts.
#
#   · Never put a comment on the same line as a value. A shell strips it;
#     `docker --env-file` does not, and your API key silently becomes
#     "yourkey   # the real one". Comments go on their own line, as below.
#
# ── Before going live, check these five ──────────────────────────────────
#   1. JWT_SECRET and PAYMENT_CREDENTIALS_MASTER_KEY_B64 are freshly generated
#      and unique to this deployment — never copied from another environment.
#   2. ADMIN_PASSWORD_HASH is set and ADMIN_PASSWORD is empty.
#   3. HTTPS_REDIRECT_ENABLED=true and DB_SSLMODE=require.
#   4. LOGIN_CAPTCHA_* are real Cloudflare keys, not the test ones.
#   5. DKPG_* and STRIPE_* are production values from Digital Kidu, not UAT.
# ─────────────────────────────────────────────────────────────────────────


# ════════════════════════════════════════════════════════════════════════
#  Service
# ════════════════════════════════════════════════════════════════════════

APP_NAME="PTEP Payment Gateway"
PORT=5001


# ════════════════════════════════════════════════════════════════════════
#  Database                                                     [required]
# ════════════════════════════════════════════════════════════════════════
#
# Either DATABASE_URL, or the DB_* parts. DATABASE_URL wins if both are set.
#
# DB_SSLMODE=disable is for local development only. Anywhere the database is
# not on the same host, use `require` at minimum — `verify-full` if you have
# the CA to check against.

# DATABASE_URL=postgres://user:password@host:5432/ptep_gateway?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME
DB_NAME=ptep_gateway
DB_SSLMODE=require
# Leave empty. A zone name containing a slash — which is all of them, including
# Asia/Thimphu — is percent-encoded into the DSN and reaches the driver still
# encoded, so the service dies at boot with "unknown time zone Asia%2FThimphu".
# Known defect. Nothing is lost by leaving it unset: every timestamp this
# service stores is timestamptz and is written and read in UTC, so the session
# timezone changes nothing but how a psql prompt displays them.
DB_TIMEZONE=


# ════════════════════════════════════════════════════════════════════════
#  Secrets                                                      [required]
# ════════════════════════════════════════════════════════════════════════
#
# Generate fresh for every deployment. Never reuse between environments: a
# staging leak must not become a production one.
#
#     JWT_SECRET                          openssl rand -hex 32
#     PAYMENT_CREDENTIALS_MASTER_KEY_B64  openssl rand -base64 32

# Signs admin dashboard sessions. The service refuses to start without it.
JWT_SECRET=

# Encrypts every recipient's stored payment configuration (AES-256-GCM).
# Must decode to exactly 32 bytes or the service will not start.
#
# ⚠ ROTATING THIS ORPHANS EVERY STORED CONFIGURATION. The rows stay but can no
# longer be decrypted, so every property silently becomes unpayable. Changing
# it is a migration, not an edit.
PAYMENT_CREDENTIALS_MASTER_KEY_B64=


# ════════════════════════════════════════════════════════════════════════
#  Dashboard administrator                                      [required]
# ════════════════════════════════════════════════════════════════════════
#
# The first admin, created at boot if that username does not exist. Changing
# these later does NOT update an existing user.
#
# Prefer ADMIN_PASSWORD_HASH: a plaintext password sits in the process
# environment, in your deploy config, and in anything that dumps either.
#
#     htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'

ADMIN_USERNAME=ptep-admin
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=          # leave empty in production; use the hash above

# Session cookie and lifetime.
AUTH_COOKIE_NAME=admin_session
CSRF_COOKIE_NAME=csrf_token
JWT_TTL_MINUTES=60
JWT_ISSUER=ptep-gateway-admin
JWT_AUDIENCE=ptep-gateway-admin

# Self-service admin signup. Leave both empty to keep it closed — which is the
# right answer unless you specifically need it. When ADMIN_SIGNUP_ROUTE is
# empty the route is derived from JWT_SECRET and is therefore unguessable.
ADMIN_SIGNUP_ROUTE=
ADMIN_SIGNUP_KEY=


# ════════════════════════════════════════════════════════════════════════
#  Sign-in protection
# ════════════════════════════════════════════════════════════════════════
#
# After LOGIN_MAX_ATTEMPTS failures in LOGIN_WINDOW_MINUTES, the account is
# locked for LOGIN_LOCK_MINUTES.

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# Cloudflare Turnstile, shown after this many failures.
#
# ⚠ Cloudflare publishes test keys that pass ANY token. They make the widget
# appear and stop nobody. If you copied a key beginning 1x00000000 or
# 2x00000000, the challenge on this deployment is decorative.
LOGIN_CAPTCHA_SITE_KEY=
LOGIN_CAPTCHA_SECRET=
# 0 challenges every sign-in, including the first — nobody reaches the password
# check without passing it. Raise it only if you have a reason to leave the
# first attempts unguarded, which is the window credential stuffing uses.
LOGIN_CAPTCHA_AFTER_FAILURES=0
LOGIN_CAPTCHA_TIMEOUT_SECONDS=3


# ════════════════════════════════════════════════════════════════════════
#  The bank (DKPG)                                              [required]
# ════════════════════════════════════════════════════════════════════════
#
# ONE IDENTITY FOR THE WHOLE GATEWAY. The bank knows a single integrator and
# issues it a single set of credentials, so they live here and are identical on
# every payment.
#
# What varies per property is only where its money lands — beneficiary_account,
# beneficiary_name and beneficiary_bank — and that is stored per recipient in
# the database, set through the dashboard's "Who gets paid" tab. A recipient
# record carrying any of the values below is REFUSED, not ignored.
#
# Values below are placeholders. Production values come from the Digital Kidu
# gateway team; the defaults baked into the code point at UAT, which moves no
# money. Without these, payments answer 503 GATEWAY_NOT_CONFIGURED — which is
# deliberate, and is a different answer from 400 MERCHANT_NOT_CONFIGURED (a
# property that is not set up).

DKPG_BASE_URL=https://internal-gateway.uat.digitalkidu.bt/api/dkpg
# the Gravitee key (sent as X-gravitee-api-key)
DKPG_API_KEY=
DKPG_USERNAME=
DKPG_PASSWORD=
DKPG_CLIENT_ID=
DKPG_CLIENT_SECRET=
DKPG_SOURCE_APP=
DKPG_SCOPES=keys:read

# Request signing key. Pick ONE of the three, in this order of preference.
# A file can be chmod 600 and rotated without a redeploy, and does not sit in
# the process environment where any crash dump can reach it.
DKPG_PRIVATE_KEY_FILE=/etc/ptep/dkpg-private-key.pem
# DKPG_PRIVATE_KEY_B64=
# DKPG_PRIVATE_KEY=
#
# Optional guard rails for the file path, if your platform needs them:
# SECRET_FILE_BASE_DIR=/etc/ptep
# SECRET_FILE_PATH_MODE=strict


# ════════════════════════════════════════════════════════════════════════
#  Cards (Stripe, via the Kingdom's gateway)
# ════════════════════════════════════════════════════════════════════════
#
# Same division as the bank above: one agency and one key identify this
# gateway; what distinguishes a property is submerchant_id and dk_account,
# stored per recipient.
#
# STRIPE_BASE_URL points at the Kingdom's internal gateway, NOT at Stripe.

STRIPE_BASE_URL=https://internal-gateway.sit.digitalkidu.bt:8082/uat/stripe/
STRIPE_API_KEY=
# quote it: agency names contain spaces
STRIPE_AGENCY_NAME=""
STRIPE_CURRENCY=USD

# Where the traveller is returned to after paying. Absolute URLs on the
# booking platform's public origin.
STRIPE_SUCCESS_URL=https://example.bt/booking/card/success
STRIPE_CANCEL_URL=https://example.bt/booking/card/cancelled


# ════════════════════════════════════════════════════════════════════════
#  The booking platform
# ════════════════════════════════════════════════════════════════════════
#
# Read-only, server-side. Two things need it:
#
#   · the UPI payments tab — those records live on the platform, because no UPI
#     money passes through this gateway
#   · the "Who gets paid" tab — the property list, so it can show which
#     properties are not yet set up to be paid
#
# PLATFORM_API_KEY must match INTERNAL_API_KEY on the booking platform, and
# must be at least 32 characters or the platform refuses it. Generate with:
#
#     openssl rand -hex 32
#
# Leaving both empty is valid: those two tabs then say they are not connected,
# rather than showing an empty table that reads as "there is nothing here".

PLATFORM_BASE_URL=https://api.example.bt
PLATFORM_API_KEY=


# ════════════════════════════════════════════════════════════════════════
#  Transport security
# ════════════════════════════════════════════════════════════════════════
#
# HTTPS_REDIRECT_ENABLED=false is a LOCAL DEVELOPMENT ONLY setting. On a
# deployment it means admin sessions and API keys can travel in clear text.

HTTPS_REDIRECT_ENABLED=true
SECURITY_HEADERS_ENABLED=true

# Content-Security-Policy. Empty CSP_POLICY uses the built-in policy, which is
# correct for the bundled dashboard — override only if you are serving your own
# assets from elsewhere.
CSP_ENABLED=true
CSP_POLICY=
CSP_REPORT_ONLY=false
CSP_REPORT_URI=


# ════════════════════════════════════════════════════════════════════════
#  Rate limits
# ════════════════════════════════════════════════════════════════════════
#
# Per source IP, sliding window. The defaults are sensible; raise them only
# with a measurement in hand, and remember these are the last thing standing
# between a stolen API key and a lot of money.
#
# If this service sits behind a proxy or load balancer, make sure it sees the
# real client IP — otherwise every request looks like one IP and these limits
# either throttle everybody at once or nobody at all.

# /api/business/* and /api/v1/*
BIZ_RATE_LIMIT_MAX=60
BIZ_RATE_LIMIT_WINDOW_SECONDS=60
# /api/business/pull/confirm
OTP_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_WINDOW_SECONDS=60
# /api/dkpg/*
DKPG_RATE_LIMIT_MAX=30
DKPG_RATE_LIMIT_WINDOW_SECONDS=60
# admin create/update/delete
ADMIN_WRITE_RATE_LIMIT_MAX=20
ADMIN_WRITE_RATE_LIMIT_WINDOW_SECONDS=60
# POST /api/admin/apps/create
APP_CREATE_RATE_LIMIT_MAX=5
APP_CREATE_RATE_LIMIT_WINDOW_SECONDS=60

# API key verification is bcrypt, which is deliberately slow. These bound how
# much CPU a flood of bad keys can consume.
API_KEY_AUTH_MAX_CONCURRENT=16
API_KEY_AUTH_INVALID_CACHE_SECONDS=2
API_KEY_AUTH_BUSY_RETRY_AFTER_SECONDS=1


# ════════════════════════════════════════════════════════════════════════
#  Server limits
# ════════════════════════════════════════════════════════════════════════
#
# Slowloris and resource-exhaustion guards. SERVER_MAX_CONNS_PER_IP=0 disables
# the per-IP cap; set a number if this is directly exposed to the internet.

SERVER_READ_TIMEOUT_SECONDS=10
SERVER_WRITE_TIMEOUT_SECONDS=30
SERVER_IDLE_TIMEOUT_SECONDS=60
SERVER_CONCURRENCY=4096
SERVER_MAX_CONNS_PER_IP=0
SERVER_READ_BUFFER_BYTES=8192

# ════════════════════════════════════════════════════════════════════════
#  Payees provisioned at boot
# ════════════════════════════════════════════════════════════════════════
#
# On start, the payees in this file are created if they are missing and left
# alone if they already exist, so a deploy never loses who gets paid. Relative
# paths are read from the working directory. Unset, provision.json beside the
# binary is used; with neither, nothing is provisioned.

PROVISION_FILE=provision.json
